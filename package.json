{
  "name": "agentwares-okgate",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "description": "Nothing irreversible without an OK. okgate (formerly agentguard), the MCP policy proxy for AI agents: hard spend limits, destructive-action approvals, kill switch, scoped keys, dry-run diffs, loop breaker, hash-chained audit log.",
  "keywords": [
    "okgate",
    "agentguard",
    "mcp",
    "mcp-proxy",
    "model-context-protocol",
    "ai-agents",
    "agent-safety",
    "spend-limit",
    "kill-switch",
    "dry-run",
    "audit-log",
    "claude-code",
    "claude-code-hooks",
    "claude-md",
    "agents-md",
    "codex",
    "gemini-cli",
    "coding-agents",
    "cursor",
    "guardrails",
    "mcp-server",
    "mcp-gateway",
    "mcp-security",
    "human-in-the-loop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentwares/okgate"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "pretest": "pnpm run build",
    "pretypecheck": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
